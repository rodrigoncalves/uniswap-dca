# --- secrets: never logged, never committed ---
# PRIVATE_KEY=  # optional, seed-only: copied encrypted into the database on first run, then ignored; set/replace it in the app
UNISWAP_API_KEY=...
RPC_URL=https://polygon.drpc.org                            # public RPC, no key -- see DECISIONS.md #14
RPC_URL_FALLBACK=                                           # optional second RPC; empty = none
APP_PASSWORD=                                                # REQUIRED. the app refuses to start without it.
MASTER_KEY=                                                  # REQUIRED for the app. Encrypts stored TOTP and private key. BACK IT UP outside the server.

# --- optional legacy seeds: omit for first-run setup through the app ---
# Read ONCE into an empty database, then edited in the app (DECISIONS.md #23).
# All five settings or none (none = configure them in the app). Caps are enforced in code.
# DCA_AMOUNT=200                # strategy #1
# MAX_SLIPPAGE_PCT=0.5          # percent, not fraction (0.5 = 0.5%); cap 2
# MAX_PRICE_IMPACT_PCT=1.0      # cap 3
# MAX_ORACLE_DEVIATION_PCT=2.0  # cap 5
# APPROVAL_DAYS=30              # approve cap = scheduled total * APPROVAL_DAYS; cap 90
# MIN_POL_BALANCE=0.5           # 0-100
# The app saves run time as 00:00 UTC; the external cron ticks every 15 min.
# WBTC always stays in the DCA wallet -- OUTPUT_RECIPIENT was removed; a non-empty value refuses to run.

# --- tokens (Polygon, chainId 137) ---
TOKEN_IN=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
TOKEN_IN_SYMBOL=USDT0            # note: USDT0, not USDT -- see DECISIONS.md #1
TOKEN_OUT=0x1BFD67037B42Cf73acF2047067bd4F2C47D9BfD6
TOKEN_OUT_SYMBOL=WBTC

# --- database and app ---
DB_FILE=./data/dca.db            # persistent volume on Coolify: /data/dca.db
APP_PORT=8787                    # binds 0.0.0.0 in the container (reachable by the Coolify proxy)

# --- optional email report after each scheduled run (F3) ---
RESEND_API_KEY=                  # secret. resend.com API key; empty = no report
REPORT_EMAIL_TO=                 # where the report goes (with Resend's test sender: your Resend account email)
REPORT_EMAIL_FROM=               # optional; empty = "DCA bot <onboarding@resend.dev>" (test sender, no DNS needed)
